{
  "info": {
    "_postman_id": "examvault-x-collection-v1",
    "name": "ExamVault-X API Collection",
    "description": "Complete REST API collection for ExamVault-X Secure Cloud-Based Question Paper Management System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"student@institution.edu\",\n  \"password\": \"StudentPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@institution.edu\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Question Papers",
      "item": [
        {
          "name": "Create Question Paper (Upload PDF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "CS101 Midterm Examination Paper", "type": "text" },
                { "key": "subject", "value": "Computer Science - CS101", "type": "text" },
                { "key": "examName", "value": "Fall 2026 Examination", "type": "text" },
                { "key": "examDate", "value": "2026-10-15", "type": "text" },
                { "key": "description", "value": "Draft paper for CS101", "type": "text" },
                { "key": "questionPaper", "type": "file", "src": "paper.pdf" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/question-papers",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers"]
            }
          }
        },
        {
          "name": "Get All Question Papers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/question-papers?page=1&limit=10&status=released",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "released" }
              ]
            }
          }
        },
        {
          "name": "Submit Paper for Review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/question-papers/{{paper_id}}/submit-review",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers", "{{paper_id}}", "submit-review"]
            }
          }
        },
        {
          "name": "Approve Question Paper",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewComment\": \"Verified and approved for scheduling.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/question-papers/{{paper_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers", "{{paper_id}}", "approve"]
            }
          }
        },
        {
          "name": "Reject Question Paper",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewComment\": \"Formatting errors found in Section B.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/question-papers/{{paper_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers", "{{paper_id}}", "reject"]
            }
          }
        },
        {
          "name": "Schedule Question Paper",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"releaseDate\": \"2026-10-15T09:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/question-papers/{{paper_id}}/schedule",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers", "{{paper_id}}", "schedule"]
            }
          }
        },
        {
          "name": "Release Question Paper",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/question-papers/{{paper_id}}/release",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers", "{{paper_id}}", "release"]
            }
          }
        },
        {
          "name": "Download PDF Paper",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/question-papers/{{paper_id}}/download",
              "host": ["{{base_url}}"],
              "path": ["api", "question-papers", "{{paper_id}}", "download"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard & Audits",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "summary"]
            }
          }
        },
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/audit-logs?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "audit-logs"]
            }
          }
        }
      ]
    }
  ]
}
